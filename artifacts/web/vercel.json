{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://edu-searcher-api.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://edu-searcher-api.onrender.com/storage/:path*"
    },
    {
      "source": "/((?!api|storage).*)",
      "destination": "/index.html"
    }
  ]
}
