{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workspaceapi-server-production-9ee5.up.railway.app/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://workspaceapi-server-production-9ee5.up.railway.app/storage/:path*"
    },
    {
      "source": "/((?!api|storage).*)",
      "destination": "/index.html"
    }
  ]
}
